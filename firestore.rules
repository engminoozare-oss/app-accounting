rules_version = '2';

// قوانین دسترسی پایگاه داده‌ی برنامه «حساب کتاب»
//
// هر خانواده یک «دفتر» دارد که نشانی‌اش همان «کد خانواده» است.
// دسترسی فقط وقتی داده می‌شود که:
//   ۱) درخواست از یک کاربر واردشده (ورود ناشناس) بیاید، و
//   ۲) کد خانواده حداقل ۲۴ حرف باشد، تا کسی نتواند با حدس زدن
//      کدهای کوتاه به دفتر دیگران برسد.
//
// این کد نقش رمز عبور را دارد؛ هر کسی آن را داشته باشد
// می‌تواند هزینه‌ها را ببیند و تغییر دهد.

service cloud.firestore {
  match /databases/{database}/documents {
    match /books/{bookId}/{document=**} {
      allow read, write: if request.auth != null && bookId.size() >= 24;
    }
  }
}
